<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="PluralWare"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault"
        tools:targetApi="31">

        <!-- Declares this app works without a phone companion. Required for Play Store. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Receives data the phone pushes over the Wearable Data Layer: the
            PluralKit token and app settings. Filtered by path so unrelated
            DataItem traffic doesn't wake the service. `exported="true"` is
            required for the Wear framework to bind to it.
        -->
        <service
            android:name=".WatchDataListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/pluralware/token" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/pluralware/settings" />
            </intent-filter>
        </service>

        <!--
            LONG_TEXT complication showing the current fronter(s). The
            BIND_COMPLICATION_PROVIDER permission + UPDATE_REQUEST filter are
            what register it in the system complication picker. UPDATE_PERIOD is
            0 (no polling): we push updates via ComplicationDataSourceUpdateRequester
            after a switch is registered.
        -->
        <service
            android:name=".complication.FronterComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_complication"
            android:label="Fronter"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!--
            Launcher complication: a static one-tap shortcut into the app
            (SHORT_TEXT "PW" / glyph). No token or network, so it works in any
            slot regardless of pairing state.
        -->
        <service
            android:name=".complication.LauncherComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_complication"
            android:label="Open PluralWare"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,MONOCHROMATIC_IMAGE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!--
            Fronter tile. BIND_TILE_PROVIDER + the BIND_TILE_PROVIDER action
            register it in the tile carousel picker. Refreshed on a coarse
            freshness interval and pushed via TileService.getUpdater after a switch.
        -->
        <service
            android:name=".tile.FronterTileService"
            android:exported="true"
            android:icon="@drawable/ic_complication"
            android:label="Fronter"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <!-- Placeholder preview; replace with a real tile preview image before publishing. -->
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/ic_complication" />
        </service>
    </application>
</manifest>
