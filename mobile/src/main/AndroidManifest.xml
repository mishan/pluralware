<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Friends' switch notifications (Android 13+ asks at runtime). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="PluralWare"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Receives the watch's current switch over the Wearable Data Layer, so
            an open app and the widget follow switches and member edits made on
            the watch, and the friends the watch found no longer receiving. Filtered by path;
            `exported="true"` is required for the Wear framework to bind to it.
            Never bound on a phone without Wear OS.
        -->
        <service
            android:name=".watch.PhoneDataListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/pluralware/switch" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/pluralware/sharing-status" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/pluralware/members" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.FronterWidgetReceiver"
            android:exported="true"
            android:label="Fronter">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fronter_widget_info" />
        </receiver>

        <!--
            Receives pushes for systems this person follows, via whichever
            UnifiedPush distributor they use (e.g. the ntfy app). Only the
            connector library, inside this app, binds to it.
        -->
        <service
            android:name=".following.FollowPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
