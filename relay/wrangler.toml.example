# Copy to wrangler.toml, then:
#   npx wrangler secret put ADMIN_SECRET          # a long random string; the phone needs it too
#   npx wrangler deploy
name = "pluralware-relay"
main = "src/worker.js"
compatibility_date = "2026-09-01"

# The relay's state: one SQLite-backed Durable Object (available on the free plan).
[[durable_objects.bindings]]
name = "RELAY"
class_name = "RelayState"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["RelayState"]
